{
  "name": "lavans",
  "version": "1.1.1",
  "private": true,
  "description": "Lavans AI Creative Canvas",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:backend": "node resources/backend/server.js",
    "build:win": "node scripts/package-windows.mjs",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check resources/backend/server.js && node scripts/build-update-manifest.mjs --check",
    "update:manifest": "node scripts/build-update-manifest.mjs",
    "update:manifest:check": "node scripts/build-update-manifest.mjs --check",
    "test": "node --test"
  },
  "dependencies": {
    "archiver": "5.3.2",
    "axios": "1.18.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "form-data": "4.0.6",
    "https-proxy-agent": "5.0.1",
    "multer": "1.4.5-lts.2",
    "sharp": "0.35.2",
    "unzipper": "0.10.14"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "electron": "24.8.3",
    "playwright": "1.62.1"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=18"
  },
