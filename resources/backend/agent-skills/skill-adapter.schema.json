{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lavans.local/schemas/skill-adapter.schema.json",
  "title": "Lavans Agent Skill Adapter",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "status", "source", "defaults", "inputSchema", "materialPolicy", "dependencies", "stages", "capabilities", "blockers"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "status": { "enum": ["ready", "partial", "blocked", "disabled"] },
    "source": {
      "type": "object",
      "required": ["kind", "path", "entry", "readOnly"],
      "properties": {
        "kind": { "enum": ["local-folder", "bundled", "remote"] },
        "path": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "readOnly": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "defaults": { "type": "object" },
    "inputSchema": { "type": "object" },
    "materialPolicy": { "type": "object" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "required", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["skill", "tool", "local-script", "user-cli"] },
          "required": { "type": "boolean" },
          "status": { "enum": ["available", "missing", "database-missing", "deferred", "host-adapter-required"] }
        },
        "additionalProperties": true
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "canvasStage", "executor", "readiness", "costClass", "approvalRequired", "outputArtifacts"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "canvasStage": { "type": "string", "minLength": 1 },
          "executor": {
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "enum": ["local-script", "skill", "transform", "tool", "approval", "user-cli"] },
              "ref": { "type": "string" }
            },
            "additionalProperties": true
          },
          "readiness": { "enum": ["ready", "adapter-required", "blocked"] },
          "costClass": { "enum": ["free", "potentially-paid"] },
          "approvalRequired": { "type": "boolean" },
          "outputArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": true
      }
    },
    "capabilities": { "type": "object" },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": true
}
